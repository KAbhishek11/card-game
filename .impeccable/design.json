      "css": ".ds-secondary{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .2s,color .2s,transform .2s;color:var(--ink,#eee7d9);background:transparent;border:1px solid var(--line,#42453c);border-radius:6px;min-height:52px;padding:15px 25px;font-size:14px;font-weight:700}.ds-secondary:hover{background:var(--raised,#2b2e27);border-color:var(--accent,#ddc49a)}.ds-secondary:focus-visible{outline:3px solid var(--accent,#ddc49a);outline-offset:4px}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:disabled{opacity:.42;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}.ds-secondary{border:0;border-radius:10px;background:linear-gradient(#36392f,#22251f);box-shadow:inset 0 1px 1px #fff5,0 4px 1px #090d0b,0 8px 12px #0006}.ds-secondary:active{transform:translateY(4px)}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Text action",
      "kind": "nav",
      "description": "Text action from the current dark council interface.",
      "html": "<button class=\"ds-text\">How to play \u2192</button>",
      "css": ".ds-text{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .2s,color .2s,transform .2s;color:var(--ink,#eee7d9);background:transparent;border:0;padding:10px 0;min-height:40px;font-size:12px;font-weight:500}.ds-text:hover{color:var(--accent,#ddc49a);text-decoration:underline;text-underline-offset:5px}.ds-text:focus-visible{outline:3px solid var(--accent,#ddc49a);outline-offset:4px}.ds-text:active{transform:translateY(1px)}.ds-text:disabled{opacity:.42;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}",
      "refersTo": "button-text"
    },
    {
      "name": "Name field",
      "kind": "input",
      "description": "Name field from the current dark council interface.",
      "html": "<label class=\"ds-label\">Your name<input class=\"ds-input\" placeholder=\"What should your friends call you?\" autocomplete=\"nickname\"></label>",
      "css": ".ds-label{font-family:\"DM Sans\",sans-serif;font-size:12px;font-weight:600;color:var(--ink,#eee7d9)}.ds-input{display:block;width:min(300px,80vw);margin-top:10px;background:var(--paper,#171917);border:1px solid var(--line,#42453c);border-radius:6px;padding:16px;color:var(--ink,#eee7d9);font-family:\"DM Sans\",sans-serif;font-size:16px;caret-color:var(--accent,#ddc49a)}.ds-input::placeholder{color:var(--muted,#bab6a8);font-size:13px}.ds-input:focus-visible{outline:2px solid var(--accent,#ddc49a);outline-offset:3px}",
      "refersTo": "input"
    },
    {
      "name": "Team name",
      "kind": "chip",
      "description": "Team name from the current dark council interface.",
      "html": "<span class=\"ds-chip\">Tara</span>",
      "css": ".ds-chip{display:inline-block;padding:9px 16px;background:var(--raised,#2b2e27);color:var(--ink,#eee7d9);border:1px solid var(--line,#42453c);border-radius:24px;font-family:\"DM Sans\",sans-serif;font-size:12px}",
      "refersTo": "team-chip"
    },
    {
      "name": "Mobile world tabs",
      "kind": "nav",
      "description": "Mobile theme-selection controls; selection behavior is implemented by React in the app.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Art theme\"><button aria-pressed=\"true\">Katha</button><button aria-pressed=\"false\">Rang</button><button aria-pressed=\"false\">Vana</button></nav>",
      "css": ".ds-tabs{display:flex;gap:8px}.ds-tabs button{background:var(--panel,#22251f);color:var(--ink,#eee7d9);border:1px solid var(--line,#42453c);border-radius:6px;padding:10px 18px;font:600 18px \"Bricolage Grotesque\",sans-serif;cursor:pointer}.ds-tabs [aria-pressed=true]{border-color:var(--accent,#ddc49a);color:var(--accent,#ddc49a)}.ds-tabs button:hover{background:var(--raised,#2b2e27)}.ds-tabs button:focus-visible{outline:3px solid var(--accent,#ddc49a);outline-offset:4px}.ds-tabs button:active{transform:translateY(1px)}"
    },
    {
      "name": "Concealed-card caption",
      "kind": "card",
      "description": "The opaque caption over the common atlas back. This isolated preview intentionally contains no private role data or replacement artwork.",
      "html": "<button class=\"ds-back\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><strong>GUPT SABHA</strong><small>Tap to reveal your role</small></button>",
      "css": ".ds-back{display:flex;flex-direction:column;align-items:center;gap:8px;width:194px;padding:13px 8px;background:var(--paper,#171917);color:var(--ink,#eee7d9);border:1px solid var(--line,#42453c);border-radius:6px;cursor:pointer;font-family:\"DM Sans\",sans-serif;}.ds-back strong{font:600 15px \"Bricolage Grotesque\",sans-serif;letter-spacing:.05em}.ds-back small{font-size:10px;color:var(--muted,#bab6a8)}.ds-back:hover{border-color:var(--accent,#ddc49a)}.ds-back:focus-visible{outline:3px solid var(--accent,#ddc49a);outline-offset:4px}.ds-back:active{transform:translateY(1px)}"
    },
    {
      "name": "Phase guide",
      "kind": "custom",
      "description": "Phase guide from the current dark council interface.",
      "html": "<div class=\"ds-stages\" aria-label=\"Round stages\"><span aria-current=\"step\"><b>1</b> Choose</span><span><b>2</b> Vote</span><span><b>3</b> Expedition</span><span><b>4</b> Final call</span></div>",
      "css": ".ds-stages{display:flex;gap:13px;flex-wrap:wrap;font-family:\"DM Sans\",sans-serif;}.ds-stages>span{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted,#bab6a8)}.ds-stages b{width:19px;height:19px;display:grid;place-items:center;border:1px solid var(--line,#42453c);border-radius:50%;font-size:9px;font-weight:400}.ds-stages [aria-current]{color:var(--accent,#ddc49a)}.ds-stages [aria-current] b{background:var(--accent,#ddc49a);color:var(--on-accent,#211e19);border-color:var(--accent,#ddc49a)}"
    },
    {
      "name": "Expedition choice",
      "kind": "button",
      "description": "Expedition choice from the current dark council interface.",
      "html": "<button class=\"ds-quest\"><strong>Support</strong><span>Help the expedition succeed</span></button>",
      "css": ".ds-quest{display:flex;flex-direction:column;align-items:center;gap:18px;padding:35px 12px;min-width:160px;min-height:223px;background:#ceddb4;color:#21351e;border:0;border-radius:12px;box-shadow:0 12px 20px #0002;cursor:pointer;transition:transform .2s;font-family:\"DM Sans\",sans-serif;}.ds-quest strong{font:600 29px \"Bricolage Grotesque\",sans-serif}.ds-quest span{font-size:11px}.ds-quest:hover{transform:translateY(-5px) rotate(-1deg)}.ds-quest:focus-visible{outline:3px solid var(--accent,#ddc49a);outline-offset:4px}.ds-quest:active{transform:translateY(1px)}.ds-quest:disabled{opacity:.42;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-quest{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Three Worlds, One Secret Council",
    "overview": "An illustrated moonlit Indian council chamber frames three illustrated worlds: Katha\u2019s black and bone silhouettes, Rang\u2019s saturated pop portraits, and Vana\u2019s teal forest action and luminous spirit contours. A three-card fan, compact room menu, grotesque titles, and tactile controls give the council its character.\n\nTheme selection changes the entire surface palette and deck artwork while preserving the rules and decision hierarchy. Clear shared actions and deliberately concealed identity support experienced players and first-time friends at the same table.",
    "keyCharacteristics": [
      "Three distinct illustrated decks within a moonlit council chamber.",
      "Bricolage Grotesque titles and DM Sans instructions, served locally.",
      "Recessed game surfaces, beveled metal controls, and reflective foil cards.",
      "Explicit role reveal and a mobile private-card drawer."
    ],
    "rules": [
      {
        "name": "The Whole World Rule",
        "body": "Change the deck and its complete surface palette together; retain the same decision hierarchy.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do reskin canvas, panels, text, borders, and feedback together when changing themes.",
      "Do preserve visible keyboard focus, reduced-motion states, and labels alongside status colors.",
      "Do keep role artwork and knowledge concealed until explicit reveal.",
      "Do use the current three atlases and preserve their recorded provenance."
    ],
    "donts": [
      "Don't reintroduce the superseded cream canvas, Caslon headings, or old theme names.",
      "Don't change mechanics or public information hierarchy between themes.",
      "Don't encode allegiance in card backs or public announcements.",
      "Don't substitute decorative portrait art for readable rules or action labels."
    ]
  }
}
